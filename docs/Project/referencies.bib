@article{meng_curated_2021,
  title        = {A Curated Diverse Molecular Database of Blood-Brain Barrier Permeability with Chemical Descriptors},
  author       = {Meng, Fanwang and Xi, Yang and Huang, Jinfeng and Ayers, Paul W.},
  date         = {2021-10-29},
