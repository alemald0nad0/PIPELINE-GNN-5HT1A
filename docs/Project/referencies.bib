  title        = {{{SS-GNN}}: {{A Simple-Structured Graph Neural Network forAffinity Prediction}}},
  shorttitle   = {{{SS-GNN}}},
  author       = {Zhang, Shuke and Jin, Yanzhao and Liu, Tianmeng and Wang, Qi and Zhang, Zhaohui and Zhao, Shuliang and Shan, Bo},
  date         = {2023-06-27},
  journaltitle = {ACS Omega},
  volume       = {8},
  number       = {25},
